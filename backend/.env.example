# DocAiApp Backend Environment Variables

# Security
SECRET_KEY=your-super-secret-key-change-it-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# Use postgresql+asyncpg://user:pass@host:port/db for SQLAlchemy async
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/docai

# Redis
REDIS_URL=redis://redis:6379/0

# AI Services
OPENAI_API_KEY=sk-your-openai-api-key

# Vector Store
FAISS_INDEX_PATH=/app/faiss_index

# File Storage
UPLOAD_DIR=/app/uploads

# App Settings
PROJECT_NAME=DocAiApp
VERSION=0.1.0
DEBUG=True
