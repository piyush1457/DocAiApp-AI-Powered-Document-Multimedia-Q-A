# ==============================================================================
# DocAiApp Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# ==============================================================================

# --- DATABASE (PostgreSQL) ---
# Host 'postgres' is the service name defined in docker-compose.yml
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=qaapp
POSTGRES_USER=qauser
POSTGRES_PASSWORD=changeme_in_production # REQUIRED: Change this!

# Constructed URL used by SQLAlchemy (asyncpg driver)
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- CACHE & QUEUE (Redis) ---
# Host 'redis' is the service name defined in docker-compose.yml
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_in_production # REQUIRED: Change this!

# Constructed URL used by the application
# REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# --- AI PROVIDERS ---
# Gemini API Key: Get it from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key: Get it from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Optional, if using OpenAI models)
OPENAI_API_KEY=sk-your_openai_key_here

# --- SECURITY & AUTH ---
# Secret key for JWT signing. Generate with: openssl rand -hex 32
SECRET_KEY=generate_a_secure_32_character_hex_string_here

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- GENERAL APP SETTINGS ---
# Set to 'production' in live environments
ENVIRONMENT=development
DEBUG=true

# CORS: Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# File Upload Constraints (Must also be respected by Nginx client_max_body_size)
MAX_UPLOAD_SIZE_MB=500
FAISS_INDEX_PATH=/app/faiss_indexes
UPLOAD_DIR=/app/uploads
